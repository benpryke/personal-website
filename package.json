{
  "name": "benjamin-pryke",
  "version": "0.1.1",
  "homepage": "https://www.benpryke.com",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vp dev",
    "build": "vp build && vp run prerender",
    "prerender": "node scripts/prerender.js",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vp test --watch=false",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage --watch=false",
    "predeploy": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "gh-pages -b master -d dist -r https://github.com/benpryke/benpryke.github.io.git"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@csstools/postcss-global-data": "4.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "gh-pages": "6.3.0",
    "jsdom": "30.1.3",
    "postcss-custom-media": "12.0.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  }
}
